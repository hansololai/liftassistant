# ── LLM Configuration ─────────────────────────────────────────────────────────
# Options: ollama | deepseek | openai | gemini
LLM_PROVIDER=ollama

# For Ollama (local, free, private):
LLM_MODEL=ollama/orieg/gemma3-tools:latest
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=

# For DeepSeek API (cheap, cloud):
# LLM_MODEL=deepseek/deepseek-chat
# LLM_API_KEY=your-deepseek-api-key-here

# For OpenAI:
# LLM_MODEL=openai/gpt-4o
# LLM_API_KEY=sk-...

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Download credentials.json from Google Cloud Console:
# https://console.cloud.google.com → APIs → Gmail API → OAuth credentials
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_MAX_RESULTS=20
GMAIL_NEWER_THAN_DAYS=2
GMAIL_SCAN_UNREAD_ONLY=false
GMAIL_FILTER_JUNK_CATEGORIES=true

# ── iCloud CalDAV (iOS Reminders + Calendar) ───────────────────────────────────
# Your Apple ID email
ICLOUD_USERNAME=your.apple.id@example.com
# Generate at: https://appleid.apple.com → Sign-In & Security → App-Specific Passwords
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ICLOUD_CALENDAR_NAME=LiftAssistant
ICLOUD_REMINDERS_LIST=LiftAssistant

# ── Price Tracker ──────────────────────────────────────────────────────────────
# Sign up free at https://serpapi.com (100 searches/month free)
SERPAPI_KEY=your-serpapi-key-here
PRICE_CHECK_INTERVAL_HOURS=6

# ── Agent Schedule ─────────────────────────────────────────────────────────────
EMAIL_SCAN_INTERVAL_MINUTES=60
HOME_AGENT_RUN_HOUR=7
